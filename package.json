{
  "name": "designlane",
  "version": "0.5.0",
  "description": "Keep your design tools in step with your app's code: reads the colours and text styles your SwiftUI, Jetpack Compose or React Native code names and syncs them to Figma.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codual-ai/designlane.git"
  },
  "homepage": "https://github.com/codual-ai/designlane#readme",
  "bugs": "https://github.com/codual-ai/designlane/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "designlane": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read/index.d.ts",
      "default": "./dist/read/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p figma-plugin/tsconfig.json && tsc -p figma-plugin/tsconfig.ui.json && tsc -p figma-plugin/tsconfig.e2e.json",
    "test": "vitest run -t \"^(?!.*speed:)\" && vitest run -t \"speed:\" --no-file-parallelism",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:plugin",
    "build:plugin": "node figma-plugin/build.mjs",
    "prepack": "node scripts/npm-readme.mjs pack",
    "postpack": "node scripts/npm-readme.mjs restore"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@figma/plugin-typings": "1.142.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
